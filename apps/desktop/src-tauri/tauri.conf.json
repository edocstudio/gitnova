{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitNova",
  "version": "0.1.0",
  "identifier": "org.gitnova.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitNova",
        "width": 1360,
        "height": 900,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../../../docs/licenses/terminal-components.txt": "licenses/terminal-components.txt",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../NOTICE": "licenses/NOTICE",
      "../../../docs/licenses/dependency-inventory.json": "licenses/dependency-inventory.json",
      "../../../docs/licenses/third-party-license-evidence.txt": "licenses/third-party-license-evidence.txt"
    }
  }
}
